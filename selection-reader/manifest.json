{
  "manifest_version": 3,
  "name": "Selection Reader",
  "version": "0.1.0",
  "description": "Reads only the text you select, sentence by sentence.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "tts",
    "storage",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "commands": {
    "read-selection": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "Read the selected text aloud"
    },
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Pause or resume reading"
    },
    "stop-reading": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Stop reading"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Selection Reader voice",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  }
}
